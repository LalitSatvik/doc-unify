# Copy to .env and adjust as needed. All values below are the
# docker-compose defaults; only needed to override for local (non-Docker)
# runs or to switch to the hosted-demo CloudProvider.

DATABASE_URL=postgresql+psycopg://docunify:docunify@localhost:5432/docunify

# "ollama" (default, fully local) or "cloud" (hosted demo).
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Only used when LLM_PROVIDER=cloud. Example values for Groq's free tier
# (an OpenAI-compatible API that also serves embeddings via
# nomic-embed-text-v1_5, matching this app's 768-dim EMBEDDING_DIM) — get
# a key at https://console.groq.com, check https://console.groq.com/docs/models
# for the current chat model lineup.
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.groq.com/openai/v1
CLOUD_CHAT_MODEL=llama-3.3-70b-versatile
CLOUD_EMBED_MODEL=nomic-embed-text-v1_5
